# Nium — compilação completa: o nium.exe de verdade, com instalador (Fase 7).
# Usada pelo scripts/build-release.sh (MOZCONFIG aponta para a cópia mozconfig-nium-release).
# A do dia a dia (Artifact Mode) continua sendo o "mozconfig".

# Marca e identidade: nium.exe. (O fabricante "Nium" e o perfil em %APPDATA%\Nium, separado do
# Firefox, vêm de um remendo do apply.py no browser/moz.configure: o Firefox não aceita isso aqui.)
ac_add_options --with-branding=browser/branding/nium
ac_add_options --with-app-basename=Nium
ac_add_options --with-distribution-id=app.nium

# Versão de lançamento: otimizada, sem depuração, sem testes nem relatório de travamento para a Mozilla
ac_add_options --enable-update-channel=release
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
# Atualizações (Fase 7, parte 2): só aceita pacotes .mar do canal do Nium, assinados com a nossa
# chave. Sem o serviço de manutenção da Mozilla (ele exige o certificado da Mozilla no updater);
# o Windows pede permissão na hora de instalar a atualização.
ac_add_options --disable-maintenance-service
export MAR_CHANNEL_ID=nium-release
export ACCEPTED_MAR_CHANNEL_IDS=nium-release

# Português junto com o inglês (traduções baixadas pelo apply.py)
ac_add_options --with-l10n-base="$topsrcdir/../firefox-l10n"

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-nium-release
