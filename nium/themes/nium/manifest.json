{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "nium-theme@nium.app"
    }
  },
  "name": "Nium",
  "description": "The Nium look: sand and teal like the Nium site, light or dark with your system.",
  "author": "Nium",
  "version": "1.1.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#e3e8de",
      "frame_inactive": "#e7ebe2",
      "toolbar": "#edf1e9",
      "toolbar_text": "#17302a",
      "icons": "#37504a",
      "icons_attention": "#3f6f5c",
      "button_background_hover": "rgba(23, 48, 42, .06)",
      "button_background_active": "rgba(23, 48, 42, .1)",
      "toolbar_field": "#f7f9f4",
      "toolbar_field_text": "#17302a",
      "toolbar_field_focus": "#fbfcf9",
      "toolbar_field_text_focus": "#17302a",
      "toolbar_field_border": "rgba(23, 48, 42, .08)",
      "toolbar_field_border_focus": "#3f6f5c",
      "toolbar_field_highlight": "rgba(63, 111, 92, .22)",
      "toolbar_field_highlight_text": "#17302a",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "transparent",
      "toolbar_vertical_separator": "rgba(23, 48, 42, .12)",
      "bookmark_text": "#17302a",
      "tab_selected": "#f7f9f4",
      "tab_text": "#17302a",
      "tab_background_text": "#37504a",
      "tab_background_separator": "rgba(23, 48, 42, .12)",
      "tab_line": "transparent",
      "tab_loading": "#3f6f5c",
      "popup": "#f4f7f1",
      "popup_text": "#17302a",
      "popup_border": "rgba(23, 48, 42, .1)",
      "popup_highlight": "rgba(63, 111, 92, .12)",
      "popup_highlight_text": "#17302a",
      "sidebar": "#e3e8de",
      "sidebar_text": "#17302a",
      "sidebar_border": "transparent",
      "sidebar_highlight": "#3f6f5c",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#e9ede4",
      "ntp_text": "#17302a",
      "focus_outline": "#3f6f5c",
      "accent": "#3f6f5c",
      "accent_hover": "#335c4c",
      "accent_text": "#ffffff"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#0c1417",
      "frame_inactive": "#0f181c",
      "toolbar": "#111c20",
      "toolbar_text": "#e9f1ed",
      "icons": "#c6d4cf",
      "icons_attention": "#9cbfae",
      "button_background_hover": "rgba(233, 241, 237, .06)",
      "button_background_active": "rgba(233, 241, 237, .1)",
      "toolbar_field": "#18252a",
      "toolbar_field_text": "#e9f1ed",
      "toolbar_field_focus": "#142024",
      "toolbar_field_text_focus": "#e9f1ed",
      "toolbar_field_border": "rgba(233, 241, 237, .06)",
      "toolbar_field_border_focus": "#9cbfae",
      "toolbar_field_highlight": "rgba(156, 191, 174, .28)",
      "toolbar_field_highlight_text": "#ffffff",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "transparent",
      "toolbar_vertical_separator": "rgba(233, 241, 237, .1)",
      "bookmark_text": "#e9f1ed",
      "tab_selected": "#1a282d",
      "tab_text": "#f1f6f3",
      "tab_background_text": "#c6d4cf",
      "tab_background_separator": "rgba(233, 241, 237, .1)",
      "tab_line": "transparent",
      "tab_loading": "#9cbfae",
      "popup": "#142024",
      "popup_text": "#e9f1ed",
      "popup_border": "rgba(214, 236, 232, .1)",
      "popup_highlight": "rgba(156, 191, 174, .16)",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#0c1417",
      "sidebar_text": "#e9f1ed",
      "sidebar_border": "transparent",
      "sidebar_highlight": "#22403a",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#0f181c",
      "ntp_text": "#e9f1ed",
      "focus_outline": "#9cbfae",
      "accent": "#9cbfae",
      "accent_hover": "#88ad9b",
      "accent_text": "#0f181c"
    }
  },
  "theme_experiment": {
    "colors": {
      "focus_outline": "--focus-outline-color",
      "accent": "--color-accent-primary",
      "accent_hover": "--color-accent-primary-hover",
      "accent_text": "--button-text-color-primary"
    }
  }
}
